{
  "name": "haqdar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Haqdar: a Gemini-powered companion for gig and informal workers in India",
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "dev": "node --env-file-if-exists=.env --watch server.js",
    "test": "node --test \"test/**/*.test.js\"",
    "lint": "eslint .",
    "test:coverage": "node --test --experimental-test-coverage \"test/**/*.test.js\""
  },
  "engines": {
    "node": ">=22.9"
  },
  "dependencies": {
    "@breezystack/lamejs": "^1.2.7",
    "compression": "^1.8.2",
    "express": "^5.1.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "axe-core": "^4.14.0",
    "eslint": "^10.13.0",
    "globals": "^17.13.0"
  }
}
