# Copy this file to .env and put your own key in it.
GEMINI_API_KEY=your-gemini-api-key
# Shared secret that the phone agent sends in the X-Copilot-Key header.
COPILOT_TOOL_KEY=make-a-long-random-value
# Optional settings:
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_TTS_MODEL=gemini-3.8-flash-tts
# PORT=3000
# WARM_TRANSLATIONS=false
