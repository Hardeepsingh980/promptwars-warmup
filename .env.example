# Copy this file to .env and put your own key in it.
GEMINI_API_KEY=your-gemini-api-key
# Shared secret that the phone agent's get_rider_status tool sends in the X-Copilot-Key header.
COPILOT_TOOL_KEY=make-a-long-random-value
# Secret that goes in the call-ended webhook URL: /api/copilot/call-ended/<token>
COPILOT_WEBHOOK_TOKEN=another-long-random-value
# Signs the login cookie. Change it to log everyone out.
SESSION_SECRET=a-third-long-random-value
# Where the JSON database is saved. Defaults to data/haqdar.json.
# DATA_FILE=data/haqdar.json
# The phone number riders forward calls to.
# PHONE_LINE=+918031450668
# Optional settings:
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_TTS_MODEL=gemini-3.8-flash-tts
# PORT=3000
# WARM_TRANSLATIONS=false
